 * Задание:
 *   - написать функцию (или макроопределение), которая определяет,
 *     принадлежит ли точка с координатами (x, y) окружности с заданным
 *     радиусом R (центр окружности — в начале координат);
 *   - написать функцию belong с переменным числом параметров, которая
 *     определяет, сколько точек с координатами (x, y) принадлежат
 *     заданной окружности;
 *   - main обращается к belong не менее трёх раз с количеством
 *     параметров 3, 9, 11.
 *
 * Схема вызова belong:   belong(k, R, x1, y1, x2, y2, ...)
 *   k  — количество параметров переменного списка (радиус R и пары (x, y)),
 *        то есть k = 1 + 2 * (число точек);
 *   R  — радиус окружности;
 *   x1, y1, ... — координаты точек (тип double).
 *   При k = 3, 9, 11 функция получает радиус и 1, 4 и 5 точек соответственно.
 *   Возвращает belong количество точек, принадлежащих окружности.
 *
 * Сборка:  g++ lab7_2_variant19.cpp -o lab7_2
 * Запуск:  ./lab7_2
 */

#include <iostream>
#include <cstdarg>    // va_list, va_start, va_arg, va_end
using namespace std;

// а) Принадлежит ли точка (x, y) окружности радиуса R с центром
//    в начале координат:  x^2 + y^2 <= R^2
bool in_circle(double x, double y, double R)
{
    return x * x + y * y <= R * R;
}

// Тот же признак в виде макроопределения (по заданию достаточно
// функции ИЛИ макроопределения — здесь приведены оба варианта)
#define IN_CIRCLE(x, y, R)  ((x) * (x) + (y) * (y) <= (R) * (R))

// б) Функция с переменным числом параметров.
//    k — число параметров, следующих за ним (радиус и пары координат).
//    Возвращает количество точек, принадлежащих окружности радиуса R.
int belong(int k, ...)
{
    va_list ap;                     // указатель на текущий параметр списка
    va_start(ap, k);                // настроили его на начало списка

    double R = va_arg(ap, double);  // первый параметр — радиус окружности
    int count = 0;

    for (int i = 1; i + 1 < k; i += 2)      // дальше параметры идут парами (x, y)
    {
        double x = va_arg(ap, double);
        double y = va_arg(ap, double);
        if (in_circle(x, y, R))             // можно и IN_CIRCLE(x, y, R)
            count++;
    }

    va_end(ap);
    return count;
}

int main()
{
    double R = 5.0;
    cout << "Окружность x^2 + y^2 <= R^2, R = " << R << endl << endl;

    // 1-й вызов: k = 3 — радиус и одна точка
    cout << "belong(3, R, 3.0, 4.0)" << endl;
    cout << "  Точка (3, 4) принадлежит окружности? "
         << (in_circle(3.0, 4.0, R) ? "да" : "нет") << endl;
    cout << "  belong вернула: " << belong(3, R, 3.0, 4.0)
         << " точку из 1" << endl << endl;

    // 2-й вызов: k = 9 — радиус и четыре точки
    cout << "belong(9, R, 3.0, 4.0, 6.0, 0.0, 1.0, 1.0, 4.0, 4.0)" << endl;
    cout << "  Точки: (3,4), (6,0), (1,1), (4,4)" << endl;
    cout << "  belong вернула: " << belong(9, R, 3.0, 4.0, 6.0, 0.0, 1.0, 1.0, 4.0, 4.0)
         << " точки из 4" << endl << endl;

    // 3-й вызов: k = 11 — радиус и пять точек
    cout << "belong(11, R, 3.0, 4.0, 6.0, 0.0, 1.0, 1.0, 4.0, 4.0, 0.0, 0.0)" << endl;
    cout << "  Точки: (3,4), (6,0), (1,1), (4,4), (0,0)" << endl;
    cout << "  belong вернула: "
         << belong(11, R, 3.0, 4.0, 6.0, 0.0, 1.0, 1.0, 4.0, 4.0, 0.0, 0.0)
         << " точек из 5" << endl;

    return 0;
}
