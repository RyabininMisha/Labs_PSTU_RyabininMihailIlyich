#include <iostream>
using namespace std;

int main() {
    int n; 
    cin >> n;

  
    for (int block = 1; block <= 2; block++) {
        
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++)
                cout << (j >= i ? "*" : " ");
            cout << endl;
        }
        cout << endl;

        
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++)
                cout << i << " " << j << " ";
            cout << endl;
        }
        cout << endl;
    }

    return 0;
}
