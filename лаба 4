#include <iostream>
#include <clocale>
using namespace std;

const int NMAX = 100;                 // максимально возможная длина массива

// Ввод n элементов кольца с клавиатуры
void InputArray(int a[], int n)
{
    for (int i = 0; i < n; i++)
    {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }
}

// Печать кольца справа налево: n элементов, начиная с К-ого и до К+1
void PrintRing(const int a[], int n, int K)
{
    if (n == 0)
    {
        cout << "Кольцо пусто" << endl;
        return;
    }
    int i = K % n;                    // кольцо: номер K может быть любым
    for (int count = 0; count < n; count++)
    {
        cout << a[i] << "  ";
        i--;                          // следующий элемент кольца - слева
        if (i < 0)
            i = n - 1;                // от первого элемента - к последнему
    }
    cout << endl;
}

// Обычная печать массива (для контроля, слева направо)
void PrintArray(const int a[], int n)
{
    for (int i = 0; i < n; i++)
        cout << a[i] << "  ";
    cout << endl;
}

// Добавление нового элемента со значением x в начало кольца
void AddFirst(int a[], int &n, int x)
{
    for (int i = n; i > 0; i--)       // сдвиг элементов вправо
        a[i] = a[i - 1];
    a[0] = x;
    n++;                              // длина массива увеличилась
}

// Добавление нового элемента со значением x в конец кольца
void AddLast(int a[], int &n, int x)
{
    a[n] = x;
    n++;                              // длина массива увеличилась
}

// Удаление из кольца нечетных элементов
void DeleteOdd(int a[], int &n)
{
    int m = 0;                        // длина массива после удаления
    for (int i = 0; i < n; i++)
        if (a[i] % 2 == 0)            // нечетные пропускаем
            a[m++] = a[i];
    n = m;                            // новая реальная длина массива
}

int main()
{
    setlocale(LC_ALL, "Russian");     // для вывода русских сообщений в Windows

    int a[NMAX];                      // статический массив для кольца
    int n;                            // реальная длина массива
    int K;                            // номер элемента, с которого печатаем
    int x;

    cout << "Лабораторная работа N 4, вариант 19" << endl;
    cout << "Однонаправленное кольцо (просмотр справа налево)" << endl << endl;

    // 1. Формирование кольца
    cout << "Введите количество элементов кольца (от 1 до " << NMAX << "): ";
    cin >> n;
    if (n < 1 || n > NMAX)
    {
        cout << "Ошибка: недопустимое количество элементов" << endl;
        return 1;
    }
    cout << "Введите " << n << " целых чисел:" << endl;
    InputArray(a, n);

    cout << "Введите номер элемента K (от 0 до " << n - 1
         << "), с которого начать печать: ";
    cin >> K;
    if (K < 0 || K >= n)
    {
        cout << "Ошибка: недопустимый номер элемента" << endl;
        return 1;
    }

    // 2. Печать кольца, начиная с К-ого элемента и до К+1
    cout << endl << "Кольцо (обход справа налево), начиная с элемента "
         << K << " и до элемента " << K + 1 << ":" << endl;
    PrintRing(a, n, K);

    // 3. Добавление в кольцо первого и последнего элементов
    if (n + 2 > NMAX)
    {
        cout << "Ошибка: в массиве нет места для двух новых элементов" << endl;
        return 1;
    }
    cout << endl << "Введите значение нового первого элемента: ";
    cin >> x;
    AddFirst(a, n, x);
    cout << "Введите значение нового последнего элемента: ";
    cin >> x;
    AddLast(a, n, x);
    cout << "Кольцо после добавления первого и последнего элементов:" << endl;
    PrintArray(a, n);

    // 4. Удаление из кольца нечетных элементов
    DeleteOdd(a, n);

    // 5. Печать кольца, начиная с К-ого элемента и до К+1
    if (n == 0)
    {
        cout << endl << "Все элементы кольца были нечетными - кольцо пусто" << endl;
        return 0;
    }
    cout << endl << "Кольцо после удаления нечетных элементов "
         << "(обход справа налево, начиная с элемента " << K % n << "):" << endl;
    PrintRing(a, n, K);

    return 0;
}
