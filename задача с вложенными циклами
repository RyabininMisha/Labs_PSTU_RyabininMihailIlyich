#include <iostream>
using namespace std;

int main() {
    int n; 
    cin >> n;
    
    long long s = 0;
    int i = 1;
    
    while (i <= n) {
        int j = i;
        long long c = 1;
        while (j <= 2 * i) {
            c *= j;
            ++j;
        }
        s += c;
        ++i;
    }
    
    cout << s;
    return 0;
}
