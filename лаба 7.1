 * Задание: написать перегруженные функции и основную программу, которая
 * их вызывает:
 *   а) для массива целых чисел находит минимальный элемент;
 *   б) для строки находит длину самого короткого слова.
 *
 * Обе функции названы одинаково min_element и различаются набором
 * параметров (массив int / строка) — это и есть перегрузка функций:
 * компилятор сам выбирает нужную версию по типам фактических параметров.
 *
 * Сборка:  g++ lab7_1_variant19.cpp -o lab7_1
 * Запуск:  ./lab7_1
 */

#include <iostream>
using namespace std;

// а) Минимальный элемент массива целых чисел из n элементов
int min_element(int n, int a[])
{
    int min = a[0];
    for (int i = 1; i < n; i++)
        if (a[i] < min)
            min = a[i];
    return min;
}

// б) Длина самого короткого слова в строке s.
//    Слово — последовательность символов, отличных от пробела и табуляции.
//    Если слов в строке нет, возвращается 0.
//    Примечание: длина считается в символах типа char. В кодировке
//    Windows-1251 (стандартной для таких лабораторных) один байт — это
//    один символ; если файл сохранён в UTF-8, каждый русский символ
//    занимает 2 байта, и счёт идёт по байтам.
int min_element(const char s[])
{
    int minLen = 0;   // длина самого короткого слова (0 — слов нет)
    int cur = 0;      // длина текущего слова

    for (int i = 0; ; i++)
    {
        if (s[i] != ' ' && s[i] != '\t' && s[i] != '\0')
        {
            cur++;                              // продолжается текущее слово
        }
        else
        {
            if (cur > 0 && (minLen == 0 || cur < minLen))
                minLen = cur;                   // слово закончилось
            cur = 0;
            if (s[i] == '\0')
                break;                          // строка закончилась
        }
    }
    return minLen;
}

int main()
{
    // Вызов первой версии функции — для массива целых чисел
    int a[] = { 7, -3, 15, 0, -12, 8, 4 };
    int n = sizeof(a) / sizeof(a[0]);

    cout << "Массив целых чисел:" << endl << "  ";
    for (int i = 0; i < n; i++)
        cout << a[i] << ' ';
    cout << endl;
    cout << "Минимальный элемент массива: " << min_element(n, a) << endl << endl;

    // Вызов второй версии функции — для строки
    char str1[] = "перегрузка функций в языке программирования";
    cout << "Строка: \"" << str1 << "\"" << endl;
    cout << "Длина самого короткого слова: " << min_element(str1) << endl << endl;

    char str2[] = "Каждый охотник желает знать";
    cout << "Строка: \"" << str2 << "\"" << endl;
    cout << "Длина самого короткого слова: " << min_element(str2) << endl;

    return 0;
}
