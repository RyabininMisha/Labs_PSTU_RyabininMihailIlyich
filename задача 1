#include <iostream>
using namespace std;
int main() {
    setlocale(LC_ALL, ".65001");

    int n, m;
    cin >> n >> m;

    int count = 1, index = 1;

    for (int i = 2; i <= n; ++i) {
        int x;
        cin >> x;
        if (x > m) {
            m = x;
            count = 1;
            index = i;
        } else if (x == m) {
            ++count;
        }
    }

    cout << m << " - максимальный, количество: " << count << " индекс: " << index;
    return 0;
}
